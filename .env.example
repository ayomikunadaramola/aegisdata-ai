
# Application
APP_NAME=AegisData AI
APP_ENV=development
LOG_LEVEL=INFO

# AWS
AWS_REGION=us-east-1
AWS_PROFILE=default
S3_BUCKET_NAME=replace-with-your-bucket-name

# Bedrock
BEDROCK_MODEL_ID=replace-with-your-model-id

# Local Data
DATA_DIR=data
RAW_DATA_DIR=data/raw
SYNTHETIC_DATA_DIR=data/synthetic

# API
API_HOST=127.0.0.1
API_PORT=8000


# ============================================================
# AegisData AI — Git Ignore Configuration
# ============================================================

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
dist/
build/

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12

# AWS / Terraform
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
tfplan
crash.log
crash.*.log
.terraform.tfstate.lock.info

# Terraform local variables and secrets
*.tfvars
!*.tfvars.example
*.tfvars.json

# Local generated data
data/raw/*
data/synthetic/*
data/processed/*
!data/raw/.gitkeep
!data/synthetic/.gitkeep

# Spark
spark-warehouse/
metastore_db/
derby.log

# Application logs
*.log
logs/

# Phase 8F — Agent Observability
# Keep local audit events out of version control
reports/observability/

# Phase 8F — Installer backups
*.phase8f.bak

# Temporary files
*.tmp
*.temp
*.swp
*.swo
*~

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/
